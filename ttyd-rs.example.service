[Unit]
Description=ttyd-rs - Share terminal over the web
After=network.target

[Service]
Type=simple
# Validate the configuration before starting (like `nginx -t`); the service
# is not started if the configuration is invalid.
ExecStartPre=/usr/local/bin/ttyd-rs -t --config /etc/ttyd-rs/config.toml
ExecStart=/usr/local/bin/ttyd-rs --config /etc/ttyd-rs/config.toml
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
KillMode=progress

# Security hardening
ReadWritePaths=/var/log/ttyd-rs

# Resource limits
LimitNOFILE=512

[Install]
WantedBy=multi-user.target
